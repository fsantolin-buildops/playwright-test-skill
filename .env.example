# ============================================================
# Playwright Test Skill — Environment Variables
# ============================================================
# Copy this file to .env and fill in your credentials.
#   cp .env.example .env
#
# NEVER commit .env to git — it's in .gitignore.
# ============================================================

# --- Test User Credentials ---
# The test account used to log in to the webapp
TEST_USER_EMAIL=your-test-user@example.com
TEST_USER_PASSWORD=your-test-password-here

# --- Fallback Base URL ---
# Used when no preview URL is found in the PR
BUILDOPS_BASE_URL=https://app.example.com
